<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Audio must keep playing when the screen locks or the app backgrounds.
	     Without this, CarPlay playback dies the moment the phone sleeps. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Offered on the sign-in screen of a fresh install. Comes from
	     AOIDE_DEFAULT_SERVER in Config/Local.xcconfig; empty means "ask". -->
	<key>AoideDefaultServer</key>
	<string>$(AOIDE_DEFAULT_SERVER)</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- CarPlay requires multiple-scene support: the car screen and the phone
		     screen are two live scenes at once. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<!-- The phone window. Declared with no delegate class so the SwiftUI
			     App lifecycle supplies its own. -->
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
			<!-- The car screen. -->
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- A public server is HTTPS, so we do NOT need a blanket arbitrary-loads
	     exception — and asking for one invites an App Review question we'd have
	     no good answer to. `NSAllowsLocalNetworking` alone still permits plain
	     HTTP to LAN addresses, which is all a self-hosted fallback needs. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Declares which intents this app services. Without INPlayMediaIntent here,
	     Siri never routes a spoken music request to us. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INPlayMediaIntent</string>
		<!-- Siri routes a spoken music request to one of these two depending on
		     phrasing. Declaring only Play meant "search for X on Aoide" had
		     nowhere to go, and Siri answered that it couldn't search for music. -->
		<string>INSearchForMediaIntent</string>
	</array>

	<key>NSSiriUsageDescription</key>
	<string>Aoide uses Siri so you can ask for music from your library without touching your phone.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>Aoide needs local network access to reach your Jellyfin server at home.</string>

	<!-- iOS 11+ resolves the Home Screen icon through this top-level key. actool
	     writes a nested copy inside CFBundleIcons but not always this one, and
	     without it the app installs with no icon at all — and an App Store upload
	     is rejected with ITMS-90713. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
