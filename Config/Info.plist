<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Audio must keep playing when the screen locks or the app backgrounds.
	     Without this, CarPlay playback dies the moment the phone sleeps. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- CarPlay requires multiple-scene support: the car screen and the phone
		     screen are two live scenes at once. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<!-- The phone window. Declared with no delegate class so the SwiftUI
			     App lifecycle supplies its own. -->
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
			<!-- The car screen. -->
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- music.example.net is HTTPS, so we do NOT need a blanket arbitrary-loads
	     exception — and asking for one invites an App Review question we'd have
	     no good answer to. `NSAllowsLocalNetworking` alone still permits plain
	     HTTP to LAN addresses, which is all a self-hosted fallback needs. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Declares which intents this app services. Without INPlayMediaIntent here,
	     Siri never routes a spoken music request to us. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INPlayMediaIntent</string>
	</array>

	<key>NSSiriUsageDescription</key>
	<string>JellyMusic uses Siri so you can ask for music from your library without touching your phone.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>JellyMusic needs local network access to reach your Jellyfin server at home.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
