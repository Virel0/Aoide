<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CarPlay audio. Granted by Apple against this App ID on 2026-08-06 and ticked
	  on the identifier; the profile and signature both carry it.

	  Not self-service, so it does not travel: a new App ID, or a different team,
	  needs its own request at https://developer.apple.com/contact/carplay/ (app
	  type: Audio) and weeks of latency. Simulator builds ignore it entirely.
	-->
	<key>com.apple.developer.carplay-audio</key>
	<true/>

	<!--
	  Siri. Unlike CarPlay this one is self-service: tick "SiriKit" on the App ID
	  in Certificates, Identifiers & Profiles and automatic signing picks it up.
	-->
	<key>com.apple.developer.siri</key>
	<true/>
</dict>
</plist>
